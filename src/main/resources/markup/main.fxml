<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pll.desktop.hyprtasks.MainController">
   <top>
      <VBox>
         <MenuBar>
            <menus>
               <Menu text="File">
                  <items>
                     <MenuItem accelerator="Shortcut+Q" text="Close" />
                  </items>
               </Menu>
               <Menu text="Edit">
                  <items>
                     <MenuItem accelerator="Delete" text="Delete" />
                  </items>
               </Menu>
               <Menu text="Help">
                  <items>
                     <MenuItem text="About" />
                  </items>
               </Menu>
            </menus>
         </MenuBar>

         <ToolBar styleClass="app-toolbar">
            <TextField fx:id="searchField" prefWidth="320" promptText="Поиск задач..." HBox.hgrow="ALWAYS" />
            <Button text="Фильтры" />
            <Separator orientation="VERTICAL" />
            <Button defaultButton="true" onAction="#addItem" text="+ Задача" />
            <Region HBox.hgrow="ALWAYS" />
            <Button text="Обновить" />
         </ToolBar>
      </VBox>
   </top>
   <center>
      <HBox BorderPane.alignment="CENTER">
         <children>
            <TabPane tabClosingPolicy="UNAVAILABLE" HBox.hgrow="ALWAYS">
               <tabs>
                  <Tab text="Kanban">
                     <content>
                        <HBox>
                           <children>
                              <TitledPane alignment="CENTER" collapsible="false" maxHeight="1.7976931348623157E308" prefWidth="200.0" text="Todo" textAlignment="CENTER">
                                 <content>
                                    <VBox prefHeight="200.0" prefWidth="100.0">
                                       <children>
                                          <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addItem" text="Add item" />
                                       </children>
                                    </VBox>
                                 </content>
                              </TitledPane>
                              <TitledPane alignment="CENTER" collapsible="false" layoutX="10.0" layoutY="10.0" maxHeight="1.7976931348623157E308" prefWidth="200.0" text="In progress" textAlignment="CENTER">
                                 <content>
                                    <VBox prefHeight="200.0" prefWidth="100.0">
                                       <children>
                                          <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addItem" text="Add item" />
                                       </children>
                                    </VBox>
                                 </content>
                              </TitledPane>
                              <TitledPane alignment="CENTER" collapsible="false" layoutX="210.0" layoutY="10.0" maxHeight="1.7976931348623157E308" prefWidth="200.0" text="On review" textAlignment="CENTER">
                                 <content>
                                    <VBox prefHeight="200.0" prefWidth="100.0">
                                       <children>
                                          <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addItem" text="Add item" />
                                       </children>
                                    </VBox>
                                 </content>
                              </TitledPane>
                              <TitledPane alignment="CENTER" collapsible="false" layoutX="410.0" layoutY="10.0" maxHeight="1.7976931348623157E308" prefWidth="200.0" text="Done" textAlignment="CENTER">
                                 <content>
                                    <VBox prefHeight="200.0" prefWidth="100.0">
                                       <children>
                                          <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#addItem" text="Add item" />
                                       </children>
                                    </VBox>
                                 </content>
                              </TitledPane>
                           </children>
                        </HBox>
                     </content>
                  </Tab>
                  <Tab text="Table">
                     <content>
                        <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
                           <children>
                              <TableView editable="true" tableMenuButtonVisible="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                 <columns>
                                    <TableColumn prefWidth="75.0" text="ID" />
                                    <TableColumn prefWidth="75.0" text="Name" />
                                    <TableColumn prefWidth="75.0" text="Priority" />
                                    <TableColumn prefWidth="75.0" text="Status" />
                                 </columns>
                              </TableView>
                           </children>
                        </AnchorPane>
                     </content>
                  </Tab>
               </tabs>
            </TabPane>
         </children>
      </HBox>
   </center>
   <left>
      <VBox fx:id="navigation" maxWidth="260" minWidth="64" prefWidth="200" spacing="4">
         <ToggleButton fx:id="profileButton" maxWidth="Infinity" onAction="#relocate" text="Профиль" />
         <ToggleButton fx:id="tasksButton" maxWidth="Infinity" onAction="#relocate" selected="true" text="Задачи" />
         <ToggleButton fx:id="notesButton" maxWidth="Infinity" onAction="#relocate" text="Заметки" />
         <Region VBox.vgrow="ALWAYS" />
         <Separator />
         <Button maxWidth="Infinity" text="Настройки" />

      </VBox>
   </left>
   <bottom>
      <HBox alignment="CENTER_LEFT" spacing="12" styleClass="status-bar">
         <Label fx:id="statusLabel" text="Готово" />
         <Region HBox.hgrow="ALWAYS" />
         <Label fx:id="tasksCounter" text="Задач: 0" />
      </HBox>
   </bottom>
</BorderPane>
